# PostgreSQL / Redis
DATABASE_URL=postgresql+psycopg://canvas_app_d416715b:FILL_PASSWORD@121.199.52.72:5432/enrui_ai_commerce_agent
REQUIRE_POSTGRES=true
REQUIRE_ONLINE_SERVICES=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://121.199.52.72:6379/0
REDIS_KEY_PREFIX=enrui-ai-commerce-agent:

# Aliyun OSS
STORAGE_PROVIDER=aliyun_oss
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=FILL_ROTATED_ACCESS_KEY_ID
ALIYUN_OSS_ACCESS_KEY_SECRET=FILL_ROTATED_ACCESS_KEY_SECRET
ALIYUN_OSS_BUCKET_NAME=commerce-agent-raw
ALIYUN_OSS_PREFIX=enrui-ai-commerce-agent/

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=FILL_RANDOM_AUTH_SECRET
ACCESS_TOKEN_HOURS=24

# Model services
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=FILL_LLM_API_KEY
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o
LLM_MOCK_MODE=false
IMAGE_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GENERATION_API_KEY=FILL_IMAGE_API_KEY
IMAGE_GENERATION_MODEL=FILL_IMAGE_MODEL
IMAGE_GENERATION_TIMEOUT_SECONDS=240
IMAGE_GENERATION_WATERMARK=false

HOST=0.0.0.0
PORT=8000
DEBUG=false
UPLOAD_DIR=/tmp/enrui-uploads
